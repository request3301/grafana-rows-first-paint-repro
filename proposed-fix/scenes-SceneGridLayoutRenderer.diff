@@ -0,0 +1,64 @@
+import { RefCallback, useLayoutEffect, useState } from 'react';
+
+export interface ElementSize {
+  width: number;
+  height: number;
+}
+
+const EMPTY_SIZE: ElementSize = { width: 0, height: 0 };
+
+/**
+ * Like react-use `useMeasure`, but the first measurement happens synchronously in a layout effect.
+ *
+ * `useMeasure` only reports a size from the ResizeObserver callback. That update is applied after the browser has
+ * painted the element once with size 0. For a grid that means one frame without the grid. When a page contains
+ * several grids (e.g. a dashboard RowsLayout, one grid per row), that frame shows every row header without any
+ * panels until all grids are rendered.
+ *
+ * State updates from layout effects are applied before paint, so the grid is rendered in the same frame as its
+ * surroundings. Later size changes are still reported by a ResizeObserver.
+ */
+export function useMeasureBeforePaint<T extends Element>(): [RefCallback<T>, ElementSize] {
+  const [element, ref] = useState<T | null>(null);
+  const [size, setSize] = useState<ElementSize>(EMPTY_SIZE);
+
+  useLayoutEffect(() => {
+    if (!element) {
+      return;
+    }
+
+    const update = ({ width, height }: ElementSize) =>
+      setSize((prev) => (prev.width === width && prev.height === height ? prev : { width, height }));
+
+    update(getContentBoxSize(element));
+
+    if (typeof ResizeObserver === 'undefined') {
+      return;
+    }
+
+    const observer = new ResizeObserver(([entry]) => entry && update(entry.contentRect));
+    observer.observe(element);
+
+    return () => observer.disconnect();
+  }, [element]);
+
+  return [ref, size];
+}
+
+/** Same box as ResizeObserver `contentRect`: border box minus borders and padding. */
+function getContentBoxSize(element: Element): ElementSize {
+  const { width, height } = element.getBoundingClientRect();
+  const style = getComputedStyle(element);
+  const px = (value: string) => parseFloat(value) || 0;
+
+  return {
+    width: Math.max(
+      0,
+      width - px(style.borderLeftWidth) - px(style.borderRightWidth) - px(style.paddingLeft) - px(style.paddingRight)
+    ),
+    height: Math.max(
+      0,
+      height - px(style.borderTopWidth) - px(style.borderBottomWidth) - px(style.paddingTop) - px(style.paddingBottom)
+    ),
+  };
+}
