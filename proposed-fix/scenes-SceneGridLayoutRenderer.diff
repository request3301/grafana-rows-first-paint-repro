@@ -0,0 +1,62 @@
+import { act, render } from '@testing-library/react';
+import React, { useLayoutEffect } from 'react';
+
+import { ElementSize, useMeasureBeforePaint } from './useMeasureBeforePaint';
+
+describe('useMeasureBeforePaint', () => {
+  let observerCallback: ResizeObserverCallback | undefined;
+  const disconnect = jest.fn();
+
+  beforeEach(() => {
+    observerCallback = undefined;
+    disconnect.mockClear();
+    window.ResizeObserver = jest.fn().mockImplementation((cb: ResizeObserverCallback) => {
+      observerCallback = cb;
+      return { observe: jest.fn(), unobserve: jest.fn(), disconnect };
+    });
+    jest.spyOn(HTMLElement.prototype, 'getBoundingClientRect').mockReturnValue({ width: 820, height: 610 } as DOMRect);
+  });
+
+  afterEach(() => {
+    jest.restoreAllMocks();
+  });
+
+  function Measured({ onSize, style }: { onSize: (size: ElementSize) => void; style?: React.CSSProperties }) {
+    const [ref, size] = useMeasureBeforePaint<HTMLDivElement>();
+    // Layout effects of the same commit run before paint: this records what the first painted frame shows.
+    useLayoutEffect(() => {
+      onSize(size);
+    });
+    return <div ref={ref} style={style} />;
+  }
+
+  it('reports the content box size before the first paint, without waiting for ResizeObserver', () => {
+    const sizes: ElementSize[] = [];
+    render(<Measured onSize={(s) => sizes.push(s)} style={{ padding: '5px 10px', borderWidth: 0 }} />);
+
+    expect(sizes[sizes.length - 1]).toEqual({ width: 800, height: 600 });
+    expect(observerCallback).toBeDefined();
+  });
+
+  it('follows later size changes from ResizeObserver and ignores unchanged sizes', () => {
+    const sizes: ElementSize[] = [];
+    render(<Measured onSize={(s) => sizes.push(s)} />);
+    const renders = sizes.length;
+
+    act(() =>
+      observerCallback!([{ contentRect: { width: 820, height: 610 } } as ResizeObserverEntry], {} as ResizeObserver)
+    );
+    expect(sizes).toHaveLength(renders);
+
+    act(() =>
+      observerCallback!([{ contentRect: { width: 500, height: 300 } } as ResizeObserverEntry], {} as ResizeObserver)
+    );
+    expect(sizes[sizes.length - 1]).toEqual({ width: 500, height: 300 });
+  });
+
+  it('disconnects the observer on unmount', () => {
+    const { unmount } = render(<Measured onSize={() => {}} />);
+    unmount();
+    expect(disconnect).toHaveBeenCalled();
+  });
+});
